{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaix.example/schemas/v1/credential-envelope.schema.json",
  "title": "CredentialEnvelope",
  "description": "Carrier for a signed claim. This envelope is not by itself a conformant W3C VC; only a full selected VC profile could be called that. proof is a detached JWS over the canonical document without the proof field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "issuer",
    "subjectRef",
    "claimsDigest",
    "schemaRef",
    "validFrom",
    "validUntil",
    "statusRef",
    "proofSuite"
  ],
  "properties": {
    "schemaId": { "const": "rwaix.credential.v1" },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "subjectRef": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/id" },
    "claimsDigest": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/digest" },
    "claims": { "type": "object" },
    "schemaRef": { "type": "string", "minLength": 1, "maxLength": 128 },
    "validFrom": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/timestamp" },
    "validUntil": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/timestamp" },
    "statusRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "proofSuite": { "const": "jws-p256" },
    "proof": { "type": "string", "minLength": 1 }
  }
}
