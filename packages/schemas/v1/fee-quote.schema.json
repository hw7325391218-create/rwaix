{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaix.example/schemas/v1/fee-quote.schema.json",
  "title": "FeeQuote",
  "description": "Binds quote id, unit, fee asset (chain, contract, decimals), max debit, payee, rate source, rate time, expiry, and refund rule. Acceptance fixes settledAmount. A later price move does not rewrite consumed amount.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "quoteId",
    "quoteUnit",
    "assetId",
    "chainId",
    "contractAddress",
    "decimals",
    "maxDebit",
    "settledAmount",
    "payee",
    "rateSource",
    "rateTime",
    "expiry",
    "refundRule",
    "obligationId",
    "obligationKind"
  ],
  "properties": {
    "schemaId": { "const": "rwaix.fee.quote.v1" },
    "quoteId": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/id" },
    "quoteUnit": { "type": "string", "minLength": 1, "maxLength": 32 },
    "assetId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "chainId": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/chainId" },
    "contractAddress": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/address" },
    "decimals": { "type": "integer", "minimum": 0, "maximum": 36 },
    "maxDebit": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/uint" },
    "settledAmount": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/uint" },
    "payee": { "type": "string", "minLength": 1, "maxLength": 256 },
    "rateSource": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rateTime": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/timestamp" },
    "expiry": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/timestamp" },
    "refundRule": { "enum": ["UNDELIVERED_FULL", "NONE"] },
    "obligationId": { "$ref": "https://rwaix.example/schemas/v1/defs.schema.json#/$defs/id" },
    "obligationKind": { "enum": ["NETWORK_FEE", "SERVICE"] }
  }
}
